{
    "format": "http://tdda.info/ns/tdda.serial",
    "writer": "tdda.serial-3.0.00rc1",
    "tdda.serial": {
        "fields": [
            {
                "name": "row",
                "fieldtype": "int"
            },
            {
                "name": "time",
                "fieldtype": "datetime"
            }
        ],
        "delimiter": "\t",
        "date_format": "%Y-%m-%dT%H:%M:%S",
        "datetime_format": "%Y-%m-%dT%H:%M:%S",
        "header_row_count": 1,
        "header_row": 0,
        "quoting": "QUOTE_NONE"
    }
}