{
    "format": "http://tdda.info/ns/tdda.serial",
    "tdda.serial": {
        "fields": [
            {
                "name": "d",
                "fieldtype": "date",
                "format": "%d/%m/%Y %H:%M:%S"
            },
            {
                "name": "v",
                "fieldtype": "int"
            }
        ],
        "delimiter": ","
    }
}
