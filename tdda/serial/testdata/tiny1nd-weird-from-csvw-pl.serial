{
    "format": "http://tdda.info/ns/tdda.serial",
    "writer": "tdda.serial-0.0.0",
    "polars.read_csv": {
        "separator": ";",
        "quote_char": "'",
        "null_values": [
            "."
        ],
        "encoding": "latin-1",
        "schema": {
            "IAmBoolean": "String",
            "IAmInt": "Int64",
            "f": "Float64",
            "IAmString": "String",
            "IAmDate": "String"
        }
    }
}