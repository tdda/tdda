{
    "format": "http://tdda.info/ns/tdda.serial",
    "writer": "tdda.serial-0.0.0",
    "tdda.serial": {
        "fields": [
            {
                "name": "Z",
                "fieldtype": "int"
            },
            {
                "name": "Name",
                "fieldtype": "string"
            },
            {
                "name": "Symbol",
                "fieldtype": "string"
            },
            {
                "name": "Period",
                "fieldtype": "int"
            },
            {
                "name": "Group",
                "fieldtype": "int"
            },
            {
                "name": "AtomicWeight",
                "fieldtype": "float"
            },
            {
                "name": "ApproxDiscovery",
                "fieldtype": "date"
            }
        ],
        "encoding": "utf-8",
        "delimiter": ",",
        "quote_char": "\"",
        "date_format": "YYYY-MM-DD",
        "null_indicator": "-",
        "header_row_count": 1,
        "header_row": 0,
        "quoting": "QUOTE_STRINGS_ONLY"
    }
}