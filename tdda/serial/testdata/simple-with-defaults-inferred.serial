{
    "format": "http://tdda.info/ns/tdda.serial",
    "writer": "tdda.serial-3.0.00rc1",
    "tdda.serial": {
        "fields": [
            {
                "name": "Index",
                "fieldtype": "int"
            },
            {
                "name": "Odd",
                "fieldtype": "bool"
            },
            {
                "name": "Even",
                "fieldtype": "bool"
            },
            {
                "name": "Real",
                "fieldtype": "float"
            },
            {
                "name": "Name",
                "fieldtype": "string"
            },
            {
                "name": "LastInFeb",
                "fieldtype": "date",
                "format": "%Y-%m-%d"
            },
            {
                "name": "LastIn2024",
                "fieldtype": "datetime",
                "format": "%Y-%m-%dT%H:%M:%S"
            }
        ],
        "encoding": "UTF-8",
        "delimiter": ",",
        "quote_char": "\""
    }
}