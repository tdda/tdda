{
    "format": "http://tdda.info/ns/tdda.serial",
    "writer": "tdda.serial-3.0.00rc1",
    "pandas.DataFrame.to_csv": {
        "index": "False"
    },
    "pandas.read_csv": {
        "encoding": "UTF-8",
        "delimiter": ",",
        "quotechar": "\"",
        "escapechar": "\\",
        "na_values": "",
        "keep_default_na": false,
        "header": 0,
        "date_format": "ISO8601",
        "index_col": null,
        "dtype": {
            "b": "bool",
            "i": "int64",
            "f": "float64"
        },
        "parse_dates": [
            "t"
        ]
    }
}