                "fieldtype": "bool"
            },
            {
                "name": "Real",
                "fieldtype": "float"
            },
            {
                "name": "Name",
                "fieldtype": "string"
            },
            {
                "name": "LastInFeb",
                "fieldtype": "date"
            },
            {
                "name": "LastIn2024",
                "fieldtype": "datetime"
            }
        ],
        "encoding": "UTF-8",
        "delimiter": ","
    }
}