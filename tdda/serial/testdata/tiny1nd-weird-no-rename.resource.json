{
    "name": "tiny1nd",
    "type": "table",
    "path": "tiny1nd-weird.ssv",
    "scheme": "file",
    "format": "csv",
    "mediatype": "text/csv",
    "encoding": "latin1",
    "dialect": {
        "header": true,
        "header_rows": [
            0
        ],
        "csv": {
            "delimiter": ";",
            "quoteChar": "'",
            "doubleQuote": false,
            "escapeChar": "\\"
        }
    },
    "schema": {
        "fields": [
            {
                "name": "b",
                "type": "boolean",
                "trueValues": ["Yes", "y"],
                "falseValues": ["No", "n"]
            },
            {
                "name": "i",
                "type": "integer"
            },
            {
                "name": "f",
                "type": "number"
            },
            {
                "name": "s",
                "type": "string"
            },
            {
                "name": "t",
                "type": "date",
                "format": "%d/%M/%Y"
            }
        ],
        "missingValues": ["."]
    }
}
