{
    "format": "http://tdda.info/ns/tdda.serial",
    "writer": "tdda.serial-3.0.00rc1",
    "tdda.serial": {
        "fields": [
            {
                "name": "b",
                "fieldtype": "bool"
            },
            {
                "name": "i",
                "fieldtype": "int"
            },
            {
                "name": "f",
                "fieldtype": "float"
            },
            {
                "name": "d",
                "fieldtype": "string"
            },
            {
                "name": "s",
                "fieldtype": "string"
            }
        ],
        "delimiter": ";",
        "quote_char": "\"",
        "null_indicator": "NULL",
        "map_missing_trailing_cols_to_null": true,
        "header_row_count": 1,
        "header_row": 0,
        "quoting": "QUOTE_STRINGS_ONLY"
    }
}