{
    "format": "http://tdda.info/ns/tdda.serial",
    "writer": "tdda.serial-3.0.03",
    "pandas.read_csv": {
        "sep": "|",
        "encoding": "UTF-8",
        "escapechar": "\\",
        "quotechar": "\"",
        "doublequote": false,
        "dtype": {
            "id": "Int64",
            "name": "string"
        },
        "date_format": {
            "joined": "ISO8601",
            "last_seen": "%m/%d/%Y %H:%M:%S"
        },
        "parse_dates": [
            "joined",
            "last_seen"
        ],
        "na_values": "",
        "keep_default_na": false
    },
    "pandas.DataFrame.to_csv": {
        "sep": "|",
        "encoding": "UTF-8",
        "escapechar": "\\",
        "quotechar": "\"",
        "doublequote": false,
        "date_format": "%Y-%m-%d",
        "na_rep": ""
    }
}