{
    "format": "http://tdda.info/ns/tdda.serial",
    "writer": "tdda.serial-0.0.0",
    "tdda.serial": {
        "fields": [
            {
                "name": "Index",
                "fieldtype": "int"
            },
            {
                "name": "Odd",
                "fieldtype": "bool"
            },
            {
                "name": "Even",
                "fieldtype": "bool"
            },
            {
                "name": "Real",
                "fieldtype": "float"
            },
            {
                "name": "Name",
                "fieldtype": "string"
            },
            {
                "name": "LastInFeb",
                "fieldtype": "date"
            },
            {
                "name": "LastIn2024",
                "fieldtype": "datetime"
            }
        ],
        "encoding": "utf-8",
        "delimiter": ",",
        "date_format": "YYYY-MM-DD",
        "datetime_format": "YYYY-MM-DDTHH:MM:SS",
        "header_row_count": 1,
        "header_row": 0,
        "quoting": "QUOTE_NONE"
    }
}