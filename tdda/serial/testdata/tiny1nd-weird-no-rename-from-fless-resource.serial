{
    "format": "http://tdda.info/ns/tdda.serial",
    "writer": "tdda.serial-2.2.15",
    "tdda.serial": {
        "fields": [
            {
                "name": "b",
                "fieldtype": "bool",
                "true_values": [
                    "Yes",
                    "y"
                ],
                "false_values": [
                    "No",
                    "n"
                ]
            },
            {
                "name": "i",
                "fieldtype": "int"
            },
            {
                "name": "f",
                "fieldtype": "number"
            },
            {
                "name": "s",
                "fieldtype": "string"
            },
            {
                "name": "t",
                "fieldtype": "date",
                "format": "%d/%M/%Y"
            }
        ],
        "path": "tiny1nd-weird.ssv",
        "encoding": "latin1",
        "delimiter": ";",
        "quote_char": "'",
        "escape_char": "\\",
        "null_indicator": ".",
        "header_row_count": 1,
        "header": true,
        "stutter": false
    }
}