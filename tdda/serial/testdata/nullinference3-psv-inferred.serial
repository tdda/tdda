{
    "format": "http://tdda.info/ns/tdda.serial",
    "writer": "tdda.serial-0.0.0",
    "tdda.serial": {
        "fields": [
            {
                "name": "i",
                "fieldtype": "int"
            },
            {
                "name": "r",
                "fieldtype": "float"
            },
            {
                "name": "s",
                "fieldtype": "string"
            }
        ],
        "encoding": "utf-8",
        "delimiter": "|",
        "quote_char": "\"",
        "null_indicator": "",
        "header_row_count": 1,
        "header_row": 0,
        "quoting": "QUOTE_STRINGS_ONLY"
    }
}