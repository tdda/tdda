{
    "format": "http://tdda.info/ns/tdda.serial",
    "writer": "tdda.serial-2.2.15",
    "pandas.DataFrame.to_csv": {},
    "pandas.read_csv": {
        "encoding": "UTF-8",
        "delimiter": ",",
        "quotechar": "\"",
        "escapechar": "\\",
        "na_values": [
            ""
        ],
        "keep_default_na": false,
        "header": 0,
        "date_format": "ISO8601",
        "index_col": 0,
        "dtype": {
            "i": "float64",
            "f": "float64"
        },
        "parse_dates": [
            "t"
        ]
    }
}