{
    "format": "http://tdda.info/ns/tdda.serial",
    "writer": "tdda.serial-3.0.00rc1",
    "tdda.serial": {
        "fields": [
            {
                "name": "row",
                "fieldtype": "int"
            },
            {
                "name": "date",
                "fieldtype": "datetime"
            }
        ],
        "encoding": "UTF-8",
        "delimiter": ",",
        "quote_char": "\"",
        "escape_char": "\\",
        "date_format": "%d/%m/%Y %H:%M:%S",
        "null_indicator": "",
        "header_row_count": 1,
        "header_row": 0
    }
}