{
    "format": "http://tdda.info/ns/tdda.serial",
    "writer": "tdda.serial-0.0.0",
    "tdda.serial": {
        "fields": [
            {
                "name": "row",
                "fieldtype": "int"
            },
            {
                "name": "date",
                "fieldtype": "datetime"
            }
        ],
        "delimiter": ",",
        "date_format": "DD/MM/YY HH:MM:SS",
        "datetime_format": "DD/MM/YY HH:MM:SS",
        "header_row_count": 1,
        "header_row": 0,
        "quoting": "QUOTE_NONE"
    }
}