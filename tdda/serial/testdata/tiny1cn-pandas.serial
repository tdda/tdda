{
    "format": "http://tdda.info/ns/tdda.serial",
    "writer": "tdda.serial-0.0.0",
    "pandas.DataFrame.to_csv": {
        "index": "True"
    },
    "pandas.read_csv": {
        "encoding": "UTF-8",
        "delimiter": ",",
        "quotechar": "\"",
        "escapechar": "\\",
        "na_values": "",
        "keep_default_na": false,
        "header": 0,
        "date_format": "ISO8601",
        "index_col": 0,
        "dtype": {
            "b": "boolean",
            "i": "Int64",
            "f": "float64",
            "s": "string"
        },
        "parse_dates": [
            "t"
        ]
    }
}