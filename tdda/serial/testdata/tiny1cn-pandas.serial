{
    "format": "http://tdda.info/ns/tdda.serial",
    "writer": "tdda.serial-2.2.15",
    "tdda.serial": {
        "header_row_count": 1
    },
    "pandas.DataFrame.to_csv": {},
    "pandas.read_csv": {
        "encoding": "UTF-8",
        "delimiter": ",",
        "quotechar": "\"",
        "escapechar": "\\",
        "na_values": [
            ""
        ],
        "keep_default_na": false,
        "header": 1,
        "date_format": "ISO8601",
        "index_col": 0,
        "dtype": {
            "b": "boolean",
            "i": "Int64",
            "f": "float64",
            "s": "string"
        },
        "parse_dates": {
            "d": "ISO8601"
        }
    }
}