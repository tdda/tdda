{
    "format": "http://tdda.info/ns/tdda.serial",
    "writer": "tdda.serial-3.0.00rc1",
    "tdda.serial": {
        "fields": [
            {
                "name": "row",
                "fieldtype": "int"
            },
            {
                "name": "date",
                "fieldtype": "datetime"
            }
        ],
        "delimiter": ",",
        "date_format": "%m/%d/%Y %H:%M:%S",
        "datetime_format": "%m/%d/%Y %H:%M:%S",
        "header_row_count": 1,
        "header_row": 0
    }
}