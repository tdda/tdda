{
    "format": "http://tdda.info/ns/tdda.serial",
    "writer": "tdda.serial-3.0.00rc1",
    "tdda.serial": {
        "fields": [
            {
                "name": "row",
                "fieldtype": "int"
            },
            {
                "name": "EuroAmount",
                "fieldtype": "string"
            },
            {
                "name": "YenAmount",
                "fieldtype": "string"
            },
            {
                "name": "WideYenAmount",
                "fieldtype": "string"
            },
            {
                "name": "GBPAmount",
                "fieldtype": "string"
            },
            {
                "name": "DashKind",
                "fieldtype": "string"
            },
            {
                "name": "Dash",
                "fieldtype": "string"
            },
            {
                "name": "DQuoteKind",
                "fieldtype": "string"
            },
            {
                "name": "DQuote",
                "fieldtype": "string"
            },
            {
                "name": "SingleQuoteKind",
                "fieldtype": "string"
            },
            {
                "name": "SingleQuote",
                "fieldtype": "string"
            }
        ],
        "encoding": "UTF-16",
        "delimiter": ",",
        "quote_char": "\"",
        "escape_char": "\\",
        "stutter_quotes": false,
        "null_indicator": [
            "",
            "-"
        ],
        "header_row_count": 1,
        "header_row": 0,
        "quoting": "QUOTE_STRINGS_ONLY"
    }
}