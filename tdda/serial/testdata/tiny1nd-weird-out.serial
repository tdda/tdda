{
    "format": "http://tdda.info/ns/tdda.serial",
    "writer": "tdda.serial-0.0.0",
    "tdda.serial": {
        "fields": [
            {
                "name": "IAmBoolean",
                "csvname": "b",
                "fieldtype": "bool",
                "true_values": [
                    "Yes",
                    "y"
                ],
                "false_values": [
                    "No",
                    "n"
                ]
            },
            {
                "name": "IAmInt",
                "csvname": "i",
                "fieldtype": "int"
            },
            {
                "name": "f",
                "fieldtype": "float"
            },
            {
                "name": "IAmString",
                "csvname": "s",
                "fieldtype": "string"
            },
            {
                "name": "IAmDate",
                "csvname": "t",
                "fieldtype": "datetime",
                "format": "%d/%m/%Y"
            }
        ],
        "encoding": "latin-1",
        "delimiter": ";",
        "quote_char": "'",
        "escape_char": "`",
        "null_indicator": ".",
        "header_row_count": 1,
        "header_row": 0
    }
}