{
    "format": "http://tdda.info/ns/tdda.serial",
    "writer": "tdda.serial-0.0.0",
    "pandas.read_csv": {
        "sep": ";",
        "encoding": "latin-1",
        "quotechar": "'",
        "doublequote": false,
        "dtype": {
            "b": "boolean",
            "i": "Int64",
            "f": "Float64",
            "s": "string"
        },
        "date_format": {
            "t": "%d/%m/%Y"
        },
        "parse_dates": [
            "t"
        ],
        "na_values": ".",
        "keep_default_na": false,
        "true_values": [
            "Yes",
            "y"
        ],
        "false_values": [
            "No",
            "n"
        ]
    }
}