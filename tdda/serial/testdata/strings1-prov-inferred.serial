{
    "format": "http://tdda.info/ns/tdda.serial",
    "writer": "tdda.serial-3.0.00rc1",
    "tdda.serial": {
        "fields": [
            {
                "name": "row",
                "fieldtype": "int"
            },
            {
                "name": "s",
                "fieldtype": "string"
            },
            {
                "name": "n",
                "fieldtype": "int"
            },
            {
                "name": "r",
                "fieldtype": "float"
            },
            {
                "name": "d",
                "fieldtype": "date"
            }
        ],
        "delimiter": ",",
        "quote_char": "\"",
        "date_format": "%Y-%m-%d",
        "null_indicator": [
            "",
            " ",
            "#N/A",
            "#N/A N/A",
            "#NA",
            "-1.#IND",
            "-1.#QNAN",
            "-NaN",
            "-nan",
            "1.#IND",
            "1.#QNAN",
            "<NA>",
            "N/A",
            "NA",
            "NULL",
            "NaN",
            "None",
            "n/a",
            "nan",
            "null",
            "null ",
            "Na",
            "NaT",
            "Null",
            "na"
        ],
        "header_row_count": 1,
        "header_row": 0,
        "quoting": "QUOTE_STRINGS_ONLY"
    }
}