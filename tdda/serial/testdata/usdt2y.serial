{
    "format": "http://tdda.info/ns/tdda.serial",
    "tdda.serial": {
        "fields": [
            {
                "name": "row",
                "fieldtype": "int"
            },
            {
                "name": "date",
                "fieldtype": "datetime"
            }
        ],
        "encoding": "UTF-8",
        "delimiter": ",",
        "quote_char": "\"",
        "escape_char": "\\",
        "datetime_format": "us-datetime-2y",
        "null_indicator": "",
        "header_row_count": 1,
        "header_row": 0
    }
}
